{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "functional-registry.schema.json",
  "title": "functional_registry",
  "description": "阶段②产物：功能点枚举 + 源码锚点。join 主键 = feature_path。",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "feature_path", "source_file", "source_section", "raw_identifier"],
        "properties": {
          "name": { "type": "string" },
          "depth": { "type": "integer" },
          "feature_path": { "type": "string" },
          "source_file": { "type": ["string", "null"] },
          "source_section": { "type": "string" },
          "raw_identifier": { "type": "string" }
        }
      }
    }
  }
}
